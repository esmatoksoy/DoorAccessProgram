<Window x:Class="WpfApp1.MainWindow"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       Title="Door Access Control" Height="800" Width="900"
       MinWidth="800"
       MinHeight="450"
       Background="#F5F7FA">
    <Window.Resources>
        <Style TargetType="DatePicker">
            <Setter Property="Background" Value="LightCyan"/>
        </Style>
        <!-- Modern Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#9AEBA3" />
            <Setter Property="Foreground" Value="#002333"/>
            <Setter Property="BorderBrush" Value="#002333"/>
            <Setter Property="BorderThickness" Value="2"/>
            <!-- Thinner, visible border -->
            <Setter Property="FontFamily" Value="Century Gothic"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6"
                        SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2196F3"/>
                                <Setter Property="BorderBrush" Value="Green"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1565C0"/>
                                <Setter Property="BorderBrush" Value="DarkGreen"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="DarkBlue"/>
                                <Setter Property="Foreground" Value="DarkBlue"/>
                                <Setter Property="BorderBrush" Value="Gray"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>



        <!-- TextBox Style for Consistency -->
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="BorderBrush" Value="#002333"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- DataGrid Style for Modern Look -->
        <Style TargetType="DataGrid">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="RowBackground" Value="#E8F5E9"/>
            <!-- Very light green -->
            <Setter Property="AlternatingRowBackground" Value="#D0F8CE"/>
            <!-- Another light green -->
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="BorderBrush" Value="#159A9C"/>
            <Setter Property="BorderThickness" Value="4"/>
        </Style>


    </Window.Resources>
    <Grid Margin="10,0,0,10" Background="#DEEFE7">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40"/>
            <ColumnDefinition Width="70.8"/>
            <ColumnDefinition Width="129.2"/>
            <ColumnDefinition Width="197*"/>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="436*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="0"/>
            <RowDefinition Height="171*"/>
            <RowDefinition Height="7*"/>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="87*"/>
            <RowDefinition Height="125*"/>
            <RowDefinition Height="163*"/>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="147*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="Door Access "
                   FontSize="26"
                   FontWeight="Bold"
                   FontFamily="Bahnschrift"
                   Foreground="#159A9C"
                   Background="#DEEFE7"
                   Margin="30,26,0,15"
                   Grid.ColumnSpan="3" HorizontalAlignment="Left" Width="200" RenderTransformOrigin="1,1">
            <TextBlock.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleX="-3.641"/>
                    <RotateTransform/>
                    <TranslateTransform X="-7.213"/>
                </TransformGroup>
            </TextBlock.RenderTransform>
        </TextBlock>

        <!-- Left Panel -->
        <StackPanel Orientation="Vertical" Grid.Column="0" Background="#DEEFE7" Margin="10,10,10,-10" Grid.ColumnSpan="3" Grid.RowSpan="9" Grid.Row="1">
            <TextBlock Text="Person ID:" FontSize="20" FontFamily="Bahnschrift"  FontWeight="SemiBold" Margin="10,20,0,2" Foreground="Black" />
            <TextBox x:Name="txtPersonID" TextChanged="txtPersonID_TextChanged" PreviewTextInput="txtPersonID_PreviewTextInput" Margin="10,0,20,0" DataObject.Pasting="txtPersonID_Pasting"/>
            <TextBlock Text="Person Name:" FontSize="20" FontFamily="Bahnschrift"  FontWeight="SemiBold" Margin="10,20,10,0" Foreground="Black"/>
            <TextBox x:Name="txtPersonName" PreviewTextInput="txtPersonName_PreviewTextInput" Margin="10,10,20,0"  DataObject.Pasting="txtPersonName_Pasting"/>
            <TextBlock Text="Access Date:" FontSize="20" FontFamily="Bahnschrift"  FontWeight="SemiBold" Foreground="Black" Margin="10,20,0,2"/>
            <DatePicker x:Name="dpAccessTime" Margin="10,10,20,10"/>
            <TextBlock Text="Time (hh:mm):" FontFamily="Bahnschrift"  FontSize="20" Foreground="Black" FontWeight="SemiBold" Margin="10,10,0,2"/>
            <TextBox x:Name="txtAccessOnlyTime" Width="200" MaxLength="5" Margin="10,10,10,-10"  PreviewTextInput="txtAccessOnlyTime_PreviewTextInput" DataObject.Pasting="txtAccessOnlyTime_Pasting"/>
            <StackPanel Orientation="Vertical" Margin="0,50,0,0">
                <Button Content="ADD" Click="Button_Click_Add" Margin="30,10,30,0" FontFamily="Bahnschrift"
            Background="#E8F5E9"/>
                <!-- Very light green -->
                <Button Content="UPDATE" Click="Button_Click_Update" Margin="30,30,30,0" FontFamily="Bahnschrift"
            Background="#C8E6C9"/>
                <!-- Light green -->
                <Button Content="DELETE" Click="Button_Click_Delete" Margin="30,30,30,0" FontFamily="Bahnschrift"
            Background="#A5D6A7"/>
                <!-- Medium light green -->
                <Button Content="LIST ALL" Click="Button_Click_List" Margin="30,30,30,0" FontFamily="Bahnschrift"
            Background="#80CBC4"/>
                <!-- Light teal -->
                <Button Content="SEARCH" Click="Button_Click_Search" Margin="30,30,30,0" FontFamily="Bahnschrift"
            Background="#4DB6AC"/>
                <!-- Teal, a bit darker -->
            </StackPanel>


        </StackPanel>

        <!-- DataGrid -->
        <!-- DataGrid (Row 1) -->
        <DataGrid x:Name="dgRecords"
           Grid.Column="3"
           Margin="0,22,10,45"
           AutoGenerateColumns="True"
           IsReadOnly="True"
           SelectionMode="Single"
           SelectionChanged="dgRecords_SelectionChanged"
           MinHeight="200"
           MinWidth="300" Grid.RowSpan="7" Grid.ColumnSpan="3"/>

        <!-- Chart (Row 2, initially hidden) -->
        <lvc:CartesianChart x:Name="myChart"
                     Grid.Column="3"
                     Grid.Row="7"
                     Margin="0,5,0,-20"
                     Background="White"
                     Visibility="Collapsed" Grid.RowSpan="3" Grid.ColumnSpan="3"
                            />
    </Grid>
</Window>
